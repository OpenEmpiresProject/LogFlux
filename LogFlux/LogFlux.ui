        <property name="plainText">
         <string>


                                                  ██╗      ██████╗  ██████╗ ███████╗██╗     ██╗   ██╗██╗  ██╗                                                    
                                                  ██║     ██╔═══██╗██╔════╝ ██╔════╝██║     ██║   ██║╚██╗██╔╝
                                                  ██║     ██║   ██║██║  ███╗█████╗  ██║     ██║   ██║ ╚███╔╝
                                                  ██║     ██║   ██║██║   ██║██╔══╝  ██║     ██║   ██║ ██╔██╗
                                                  ███████╗╚██████╔╝╚██████╔╝██║     ███████╗╚██████╔╝██╔╝ ██╗
                                                  ╚══════╝ ╚═════╝  ╚═════╝ ╚═╝     ╚══════╝ ╚═════╝ ╚═╝  ╚═╝


                                                   Fast, searchable, filterable file and network log viewer
                                                   
                                                                         Shortcuts:
                            ctrl+f                      search the log                         shift+e            go to previous error
                            enter (inside search)       go to next search result               w                  go to next warning
                            shift+enter (inside search) go to previous search result           shift+w            go to previous warning
                            n (inside logview)          go to next search result               space              scroll down by one page
                            shift+n (inside logview)    go to previous search result           shift+space        scroll up by one page
                            g                           go to start of the log                 m                  bookmark current line
                            shift+g                     go to end of the log (and tail)        b                  go to next bookmark
                            e                           go to next error                       shift+b            go to previous bookmark</string>
        </property>
        <property name="textInteractionFlags">
         <set>Qt::TextInteractionFlag::TextSelectableByKeyboard|Qt::TextInteractionFlag::TextSelectableByMouse</set>
        </property>
       </widget>
